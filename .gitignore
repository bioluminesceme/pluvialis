/target
**/*.rs.bk
*.pdb
# Built or copied binaries (e.g. a release exe staged at the root to carry to
# another machine). The real build output lives under target/.
*.exe

# The user's own dictionaries and documents: personal vocabulary and writing,
# not part of the source. Pluvialis creates and seeds these folders on first
# run.
/dictionaries/
/documents/
/.pluvialis-history/
pluvialis.log
config.toml
/pluvialis-config.json
# The counts behind the Stats screen. It holds the words she writes, so it
# stays local like the dictionaries and documents do.
/pluvialis-stats.json

# Working and AI-collaboration docs: private notes, plan, decisions, and the
# instructions Claude Code works from. Not published.
/CLAUDE.md
/PLAN.md
/ARCHIVE.md
/DECISIONS.md
/thingstonote.md

# Reference docs kept out of the public repo: the Stenograph USB protocol
# write-up (kept private out of caution over what Stenograph considers
# proprietary; the implementation stays), and the audit of the user's own
# dictionaries (personal paths and contents).
/reference/STENOGRAPH-PROTOCOL.md
/reference/DICTIONARY-AUDIT.md

# Generated during the jeff-phrasing differential test (M6)
/tests/generated/
